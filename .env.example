# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used by NextAuth to sign session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=""

# Vercel Blob store token (Storage tab of your Vercel project -> Blob -> Create Store).
BLOB_READ_WRITE_TOKEN=""
