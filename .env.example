# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used by NextAuth to sign session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=""

# Vercel Blob store token (Storage tab of your Vercel project -> Blob -> Create Store).
BLOB_READ_WRITE_TOKEN=""

# Réseaux sociaux (optionnel) : un lien n'apparaît dans le pied de page que s'il est renseigné.
SOCIAL_WHATSAPP_URL=""
SOCIAL_FACEBOOK_URL=""
SOCIAL_TIKTOK_URL=""

# Connexion avec Google (optionnel) : le bouton n'apparaît que si les deux valeurs sont renseignées.
# Console Google Cloud > API et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisé : https://VOTRE-SITE/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Informations légales de l'éditeur (mentions légales) : un champ vide n'est pas affiché.
LEGAL_COMPANY_NAME=""
LEGAL_COMPANY_FORM=""
LEGAL_CAPITAL=""
LEGAL_RCCM=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_DIRECTOR=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
